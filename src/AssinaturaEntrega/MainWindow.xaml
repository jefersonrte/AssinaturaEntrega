<Window x:Class="AssinaturaEntrega.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captura de Assinatura de Entrega"
        Height="720" Width="1180"
        MinHeight="620" MinWidth="980"
        FontFamily="Segoe UI"
        Background="#F3F3F3"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" FontSize="13">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="Abrir pasta de arquivos" Click="OpenArchiveFolder_Click" />
                <MenuItem Header="Editar configurações (appsettings.json)" Click="OpenConfig_Click" />
                <Separator />
                <MenuItem Header="Sair" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Envio">
                <MenuItem Header="Reenviar pendentes" Click="ResendPending_Click" />
            </MenuItem>
        </Menu>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Background="#2B2B2B" Height="30">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center"
                           Margin="12,0" Text="Pronto." FontSize="13" />
                <TextBlock x:Name="PendingText" Foreground="#FFD166" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0" FontSize="13" />
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Câmera / revisão -->
            <Border Grid.Column="0" Background="Black" CornerRadius="6" Margin="0,0,12,0">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="CameraHint" Foreground="#AAA" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Iniciando câmera..." />
                </Grid>
            </Border>

            <!-- Painel lateral -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Recorte detectado -->
                <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1"
                        CornerRadius="6" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Assinatura detectada" Style="{StaticResource Label}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Border Background="#FAFAFA" Height="120">
                            <Image x:Name="SignaturePreview" Stretch="Uniform" Margin="4" />
                        </Border>
                        <TextBlock x:Name="DetectionInfo" Style="{StaticResource Label}"
                                   Text="Capture um frame para detectar a assinatura." />
                    </StackPanel>
                </Border>

                <!-- Formulário -->
                <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Número do pedido" Style="{StaticResource Label}" />
                        <TextBox x:Name="OrderBox" />

                        <TextBlock Text="Destinatário / quem recebeu" Style="{StaticResource Label}" />
                        <TextBox x:Name="RecipientBox" />

                        <TextBlock Text="Observações" Style="{StaticResource Label}" />
                        <TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="60" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- Ações -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="CaptureButton" Content="📷  Capturar (Espaço)"
                            Background="#0A66C2" Foreground="White" FontWeight="SemiBold"
                            Click="Capture_Click" />
                    <Button x:Name="SaveSendButton" Content="✔  Salvar e enviar"
                            Background="#2E7D32" Foreground="White" FontWeight="SemiBold"
                            IsEnabled="False" Click="SaveSend_Click" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SaveLocalButton" Grid.Column="0" Content="Salvar só local"
                                Margin="0,4,4,4" IsEnabled="False" Click="SaveLocal_Click" />
                        <Button x:Name="NewCaptureButton" Grid.Column="1" Content="Nova captura"
                                Margin="4,4,0,4" IsEnabled="False" Click="NewCapture_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
